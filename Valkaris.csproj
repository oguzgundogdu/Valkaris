<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Valkaris</RootNamespace>
  </PropertyGroup>

  <!-- Godot.NET.Sdk globs every .cs file under the root; the nested projects compile themselves. -->
  <ItemGroup>
    <Compile Remove="src/Valkaris.*/**" />
    <Compile Remove="tests/**" />
    <!-- The UI test drives the game through dev-only paths and never ships. -->
    <Compile Remove="src/Presentation/Dev/**" Condition="'$(Configuration)' == 'ExportRelease'" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'ExportRelease'">
    <DefineConstants>$(DefineConstants);VALKARIS_DEV</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src/Valkaris.Core/Valkaris.Core.csproj" />
    <ProjectReference Include="src\Valkaris.Ai\Valkaris.Ai.csproj" />
  </ItemGroup>

</Project>
