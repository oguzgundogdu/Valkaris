[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/Presentation/ReportsPanel.cs" id="1"]

[node name="ReportsPanel" type="PanelContainer"]
theme_type_variation = &"CardPanel"
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "ui.reports.title"

[node name="Filter" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="Mine" type="Button" parent="Box/Filter"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SecondaryButton"
toggle_mode = true
button_pressed = true
text = "ui.reports.mine"

[node name="News" type="Button" parent="Box/Filter"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SecondaryButton"
toggle_mode = true
text = "ui.reports.news"

[node name="None" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "ui.reports.none"

[node name="Scroll" type="ScrollContainer" parent="Box"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Box/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="NewsRows" type="VBoxContainer" parent="Box/Scroll"]
unique_name_in_owner = true
visible = false
layout_mode = 2
