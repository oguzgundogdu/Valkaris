[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/Presentation/ResourceBar.cs" id="1"]

[node name="ResourceBar" type="PanelContainer"]
theme_type_variation = &"TopBarPanel"
script = ExtResource("1")

[node name="Box" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Brand" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"BrandLabel"
text = "VALKARIS"

[node name="Chips" type="HBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 26

[node name="ViewToggle" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="ViewVillage" type="Button" parent="Box/ViewToggle"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Village view (M)"
focus_mode = 0
theme_type_variation = &"SecondaryButton"
toggle_mode = true
text = "Village"

[node name="ViewWorld" type="Button" parent="Box/ViewToggle"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "World map (M)"
focus_mode = 0
theme_type_variation = &"SecondaryButton"
toggle_mode = true
text = "World"

[node name="Incoming" type="Button" parent="Box"]
unique_name_in_owner = true
visible = false
layout_mode = 2
tooltip_text = "Show on the map"
focus_mode = 0
theme_type_variation = &"SecondaryButton"
theme_override_colors/font_color = Color(0.961, 0.682, 0.243, 1)
theme_override_colors/font_hover_color = Color(0.961, 0.682, 0.243, 1)

[node name="Pause" type="Button" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Pause the match (P)"
focus_mode = 0
theme_type_variation = &"SecondaryButton"
text = "Pause"

[node name="Clock" type="Label" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
tooltip_text = "Time left in the match"
mouse_filter = 0
